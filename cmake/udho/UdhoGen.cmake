if(NOT DEFINED UDHO_RC_MANIFEST OR NOT DEFINED UDHO_RC_OUTPUT OR NOT DEFINED UDHO_RC_BUNDLE)
    message(FATAL_ERROR "UdhoGen: UDHO_RC_MANIFEST, UDHO_RC_OUTPUT, UDHO_RC_BUNDLE are all required")
endif()

if(NOT EXISTS "${UDHO_RC_MANIFEST}")
    message(FATAL_ERROR "UdhoGen: manifest not found: '${UDHO_RC_MANIFEST}'")
endif()

include("${UDHO_RC_MANIFEST}")

# ---------------------------------------------------------------- helpers
# Sanitize an arbitrary string into a valid C++ identifier fragment.
#   "app.css" -> "app_css" ;  "123abc" -> "_123abc"
function(_udhogen_ident IN OUT)
    string(REGEX REPLACE "[^A-Za-z0-9_]" "_" _s "${IN}")
    string(REGEX REPLACE "^([0-9])" "_\\1" _s "${_s}")
    set(${OUT} "${_s}" PARENT_SCOPE)
endfunction()

# Escape a string so it can be embedded inside a C++ "…" literal.
function(_udhogen_cstr IN OUT)
    string(REPLACE "\\" "\\\\" _s "${IN}")
    string(REPLACE "\"" "\\\"" _s "${_s}")
    set(${OUT} "${_s}" PARENT_SCOPE)
endfunction()

# ---------------------------------------------------------------- index
list(LENGTH UDHO_RC_TYPES _n)
if(_n EQUAL 0)
    message(FATAL_ERROR "UdhoGen: bundle '${UDHO_RC_BUNDLE}' has no resources")
endif()
math(EXPR _last "${_n} - 1")

# Every resource nests six namespaces deep:
#     udho :: embed :: autogen :: <bundle> :: <type> :: <name>
# so the close-string is a constant, documented here for the one place
# that would need to change if the depth ever does.
set(_ns_close "} } } } } }")

# ---------------------------------------------------------------- one pass
# Build two parallel lists from the same inputs, so the short name and the
# namespace-open string cannot diverge.
set(_nids    "")   # home_view
set(_ns_open "")   # namespace udho { namespace embed { … {

foreach(_i RANGE 0 ${_last})
    list(GET UDHO_RC_TYPES ${_i} _t)
    list(GET UDHO_RC_NAMES ${_i} _rn)

    _udhogen_ident("${_rn}" _nid)

    list(APPEND _nids "${_nid}")
    list(APPEND _ns_open "namespace udho { namespace embed { namespace autogen { namespace ${UDHO_RC_BUNDLE} { namespace ${_t} { namespace ${_nid} {")
endforeach()

# ---------------------------------------------------------------- emit
set(_cpp "// auto-generated by udho — do not edit\n")
string(APPEND _cpp "#include <udho/view/resources/blobs/store.h>\n")
string(APPEND _cpp "#include <cstddef>\n\n")

# ---- one namespace block per resource -----------------------------------
foreach(_i RANGE 0 ${_last})
    list(GET UDHO_RC_TYPES ${_i} _t)
    list(GET UDHO_RC_NAMES ${_i} _rn)
    list(GET UDHO_RC_PATHS ${_i} _p)
    list(GET _ns_open      ${_i} _open)

    # Bytes as a brace-init list of 0xNN.  No string literal, so no
    # \x-greedy trap, no NUL truncation, binary-safe.
    file(SIZE "${_p}" _sz)
    if(_sz GREATER 0)
        file(READ "${_p}" _hex HEX)
        string(REGEX REPLACE "(..)" "0x\\1," _bytes "${_hex}")
    else()
        # One dummy byte so C++ is happy; length below is still 0.
        set(_bytes "0x0")
    endif()

    _udhogen_cstr("${_rn}" _rn_esc)

    string(APPEND _cpp "// ${_t} \"${_rn}\" — from ${_p}\n")
    string(APPEND _cpp "${_open}\n")
    string(APPEND _cpp "const char name[]  = \"${_rn_esc}\";\n")
    string(APPEND _cpp "const unsigned char bytes[] = { ${_bytes} };\n")
    string(APPEND _cpp "const std::size_t length = ${_sz};\n")
    string(APPEND _cpp "${_ns_close}\n\n")
endforeach()

# ---- TU-local registrar -------------------------------------------------
string(APPEND _cpp "namespace {\n\n")
string(APPEND _cpp "struct _udho_rc_registrar {\n")
string(APPEND _cpp "    _udho_rc_registrar() {\n")

foreach(_i RANGE 0 ${_last})
    list(GET UDHO_RC_TYPES ${_i} _t)
    list(GET _nids        ${_i} _nid)

    if(_t STREQUAL "view")
        set(_method view)
    elseif(_t STREQUAL "js")
        set(_method js)
    elseif(_t STREQUAL "css")
        set(_method css)
    elseif(_t STREQUAL "txt")
        set(_method txt)
    elseif(_t STREQUAL "img")
        set(_method img)
    else()
        message(FATAL_ERROR "UdhoGen: unknown resource type '${_t}'")
    endif()

    string(APPEND _cpp
        "        udho::view::resources::blobs::registry().${_method}"
        "(udho::embed::autogen::${UDHO_RC_BUNDLE}::${_t}::${_nid}::name, "
        "udho::embed::autogen::${UDHO_RC_BUNDLE}::${_t}::${_nid}::bytes, "
        "udho::embed::autogen::${UDHO_RC_BUNDLE}::${_t}::${_nid}::length);\n")
endforeach()

string(APPEND _cpp "    }\n};\n\n")
string(APPEND _cpp "const _udho_rc_registrar _udho_rc_registrar_instance;\n\n")
string(APPEND _cpp "}  // namespace\n")

file(WRITE "${UDHO_RC_OUTPUT}" "${_cpp}")
