<?! vars('d', 'ctx') include.css('hello', 'hello.css') ?>
<section class="hello-view">
    <h2 class="hello-title"><?= d.heading ?></h2>
    <p class="hello-greeting">Hello, <strong class="hello-name"><?= d.name ?></strong>!</p>
    <p class="hello-message"><?= d.message ?></p>
    <ul class="planet-grid">
    <? for _, planet in ipairs(d.planets) do ?>
        <?= ctx:view("hello", "planet"):render(planet) ?>
    <? end ?>
    </ul>
    <p class="hello-navigation"><a class="hello-link" href="/">Return home</a></p>
</section>

