<?! vars('d', 'ctx') ?>
<? local planets = {
    {name = "Mars", distance = 225000000},
    {name = "Jupiter", distance = 628730000},
    {name = "Saturn", distance = 1275000000}
} ?>
<section>
    <h2><?= d.heading ?></h2>
    <p>Hello, <strong><?= d.name ?></strong>!</p>
    <p><?= d.message ?></p>
    <ul>
    <? for _, planet in ipairs(planets) do ?>
        <?= ctx:view("luax", "planet"):render(planet) ?>
    <? end ?>
    </ul>
    <p><a href="/">Return home</a></p>
</section>

